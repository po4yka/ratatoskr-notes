# Operator example for ratatoskr-notes, a systemd EnvironmentFile (EnvironmentFile=/etc/ratatoskr/notes.conf).
# Copy it to /etc/ratatoskr/notes.conf, replace every CHANGE-ME, and keep the file readable by the service user only.
# `ratatoskr-notes check-config` validates it without starting anything (exit 0 valid, exit 78 invalid).

# Operator listener: /health/live, /health/ready, /metrics, /version. Host only; allocated in docs/DEPLOYMENT_TARGET.md of ratatoskr-workspace.
RATATOSKR__ADMIN__BIND=127.0.0.1:9471

# Domain API (/v1/notes). Loopback; Edge is the only client. Allocated in docs/DEPLOYMENT_TARGET.md of ratatoskr-workspace.
RATATOSKR__API__LISTEN_ADDRESS=127.0.0.1:8099

# SECRET: the URL carries the password.
# The shared database `ratatoskr` and the role `ratatoskr_notes`, which deploy/postgres/role.sql creates (a PostgreSQL administrator runs it once, then sets the password with `\password ratatoskr_notes`). The service creates its own schema, `notes`, on the first start.
RATATOSKR__DATABASE__URL=postgres://ratatoskr_notes:CHANGE-ME@127.0.0.1:5432/ratatoskr

RATATOSKR__TELEMETRY__LOG_FORMAT=json

# The notes blob root: owner ratatoskr-notes, group ratatoskr-notes-blobs, mode 2750. The start
# fails when the umask is stricter than 0027; give the service unit UMask=0027. This line repeats
# the default.
RATATOSKR__BLOBS__ROOT=/mnt/nvme/ratatoskr/blobs/ratatoskr-notes

# The key of the stored Obsidian passwords of each sync connection: 32 random bytes, mode 0400, owner
# ratatoskr-notes. Create it once with `head -c 32 /dev/urandom`. A lost key makes the stored
# passwords unreadable; the owner then connects the vault again. This line repeats the default.
RATATOSKR__SECRETS__KEY_FILE=/etc/ratatoskr/notes-secrets.key

# How many first logins of sync connections run at the same time, 1 to 16. Each login runs ob, a
# Node.js process. A sync connect over the limit answers 503. This line repeats the default.
RATATOSKR__CONNECTIONS__MAX_LOGINS=2

# The NATS server and the seed of the NOTES identity: the outbox relay publishes the notes events and
# the operation reports with the inbox prefix _INBOX_notes. The seed file is mode 0400, owner
# ratatoskr-notes.
RATATOSKR__BUS__URL=nats://127.0.0.1:4222
RATATOSKR__BUS__NKEY_SEED_PATH=/etc/ratatoskr/notes.nkey

# The largest file that is indexed, in bytes. A larger file publishes no event. This line repeats
# the default, 64 MiB.
RATATOSKR__FILES__MAX_FILE_BYTES=67108864
